{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "cd backend && npm ci",
  "buildCommand": "cd backend && npx prisma generate && npm run build",
  "outputDirectory": ".",
  "functions": {
    "api/index.js": {
      "maxDuration": 30,
      "includeFiles": "{index.html,sw.js,manifest.webmanifest,privacy.html,icon.svg,icon-*.png,apple-touch-icon.png}"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ]
}
